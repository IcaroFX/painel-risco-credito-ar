	partition feature_importance = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "feature_importance.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {
				        {"variavel", type text}, {"coeficiente_logit", type number}, {"efeito", type text},
				        {"importancia_pct", type number}, {"importancia_rf_pct", type number}
				    }, "en-US")
				in
				    Tipos

