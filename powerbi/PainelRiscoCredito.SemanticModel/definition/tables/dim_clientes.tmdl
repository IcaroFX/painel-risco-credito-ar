	partition dim_clientes = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "dim_clientes.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {
				        {"cliente_id", type text}, {"nome_cliente", type text}, {"segmento", type text}, {"regiao", type text},
				        {"tempo_relacionamento_meses", Int64.Type}, {"limite_credito", type number},
				        {"score_bureau_externo", Int64.Type}, {"historico_atraso_12m", Int64.Type}
				    }, "en-US")
				in
				    Tipos

